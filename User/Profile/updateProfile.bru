meta {
  name: updateProfile
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/user/profile/:id/update
  body: multipartForm
  auth: bearer
}

params:path {
  id: 194
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  coverPhoto: @file(/C:/Users/E14/Downloads/testing image 2.png)
  ~firstName: 
  ~lastName: 
  ~dob:  
  ~city:  
  ~gender: 
  ~image: 
  ~profilePhoto: @file(/C:/Users/E14/Downloads/testing image.png)
}

settings {
  encodeUrl: true
}
