meta {
  name: updateAchivement
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/firm/firms/:firmId/achievement/:id
  body: json
  auth: inherit
}

params:path {
  id: 2
  firmId: 146
}

body:json {
  {
    "title": "achivment1123",
    "description" : "my achviment", 
     "achivementType" : "certficate" ,
     "isPublic" : true,
  //  if we dont want to update the images key should not be send inside body
    "images":[
      {
        "imageUrl":"",
        "storagePath":""
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
