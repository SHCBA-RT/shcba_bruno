meta {
  name: createPortfolio
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/user/portfolio/create
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:multipart-form {
  title: my portfolio
  documents: @file(/home/bilal-zia/Pictures/Screenshots/Screenshot from 2025-10-21 12-03-35.png)
  categoryId: 2
  startDate: 12/12/2000
}

settings {
  encodeUrl: true
}
