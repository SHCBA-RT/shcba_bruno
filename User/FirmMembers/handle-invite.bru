meta {
  name: handle-invite
  type: http
  seq: 2
}

post {
  url: {{accessToken}}/api/user/firm-member/handle-invite
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
      action:"accepted",
      inviteId:100
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
