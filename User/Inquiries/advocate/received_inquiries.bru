meta {
  name: received_inquiries
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/user/advocate/inquiries/received?order=desc&page=1&limit=2&isRead=true
  body: none
  auth: bearer
}

params:query {
  order: desc
  page: 1
  limit: 2
  isRead: true
}

auth:bearer {
  token: {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}
