meta {
  name: medical_request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/user/membership/benefits/medical
  body: multipartForm
  auth: bearer
}

params:query {
  ~limit: null
  ~page: null
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  patientName: abc
  relation: father
  hospitalName: abcd
  treatmentType: abc
  treatmentDate: 12/12/12
  amountClaimed: 2000
  description: 
  isReimbursement: sss
  notes: sss
  requiredDoc: @file(/home/bilal-zia/Downloads/DOMAIN AND THIER CATEGORIES DARFTING FORMATS Criminal Law.pdf)
  paymentProof: @file(/home/bilal-zia/Pictures/Screenshots/Screenshot from 2025-10-21 18-09-33.png)
  supportingDocs: @file(/home/bilal-zia/Pictures/Screenshots/Screenshot from 2025-10-21 18-32-21.png)
  isReimbursement: true
  ~documents: @file(/home/bilal-zia/Documents/BSK-Server/BSK-TV-NETWORK/documentation/BackendFeatures.pdf)
}

settings {
  encodeUrl: true
  timeout: 0
}
