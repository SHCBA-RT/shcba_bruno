meta {
  name: my_inquiries
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/user/advocate/inquiries/sent?order=desc&page=1&limit=2&isRead=true
  body: json
  auth: bearer
}

params:query {
  order: desc
  page: 1
  limit: 2
  isRead: true
}

auth:bearer {
  token: {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}
