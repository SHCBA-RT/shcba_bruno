meta {
  name: education_request
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/user/membership/benefits/education
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  childName: abc
  childDob: 12/12/12
  schoolName: abcSchool
  classGrade: 2
  amountClaimed: 10000
  requiredDoc: @file(/home/bilal-zia/Pictures/Screenshots/Screenshot from 2025-10-21 18-27-13.png)
  paymentProof: @file(/home/bilal-zia/Pictures/Screenshots/Screenshot from 2025-10-22 15-47-08.png)
  supportingDocs: @file(/home/bilal-zia/Pictures/Screenshots/Screenshot from 2025-10-23 11-14-33.png)
  isReimbursement: true
  accountNumber: 
  bankTitle: 
  IBAN: 
  accountTitle: 
  ~documents: @file(/home/bilal-zia/Pictures/Screenshots/Screenshot from 2025-10-20 14-02-56.png)
}

settings {
  encodeUrl: true
  timeout: 0
}
