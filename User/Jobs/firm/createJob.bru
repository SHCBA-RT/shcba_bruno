meta {
  name: createJob
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/user/firm/job/:firmId
  body: json
  auth: bearer
}

params:path {
  firmId: 111
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
    {
      "employmentType": "fulltime",
      "title": "backend developer2",
      "description": "developer new",
      "location": "karachi",
      "salaryMin": "100000",
      "salaryMax": "120000",
      "status": "published",
      "workplaceType": "remote",
      "requirements": {
        "education": "LLB",
        "experience": "5 years",
        "skills": "  new skill"
      },
      "coordinates": {
        "lat": "123",
        "long": "124"
      },
      "responsibilities": [
        "good advocate",
        "experienced advocate"
      ]
    }
}

settings {
  encodeUrl: true
  timeout: 0
}
