meta {
  name: transport_request
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/user/membership/benefits/transport
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:multipart-form {
  fromLocation: abc
  toLocation: abcd
  travelDate: 12/12/12
  transportType: abc
  purpose: avc
  expectiedFare: 2000
  amountClaimed: 20000
  requiredDoc: 
  paymentProof: 
  supportingDocs: 
  isReimbursement: true
  accountNumber: 
  IBAN: 
  banckTitle: 
  accountTitle: 
}

settings {
  encodeUrl: true
  timeout: 0
}
