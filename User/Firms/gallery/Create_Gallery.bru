meta {
  name: Create_Gallery
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/firm/firms/:firmId/gallery
  body: json
  auth: bearer
}

params:path {
  firmId: 146
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "images":[ 
      {
      "imageUrl":"https://storage.googleapis.com/shcba-stg.firebasestorage.app//cf7099b2-c4bc-4bf22-92e0-90a85a56421e.png",
    "storagePath":"/cf7099b2-c4bc-4bf2-92e0-90a85a56421e.png"
    }
    ],
    "title":"firm gallery"
  
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
